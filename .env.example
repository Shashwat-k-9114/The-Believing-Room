# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=
NEXT_PUBLIC_PODCAST_PLAYLIST_URL=

# --- Form responses go to a Google Sheet. Setup: google-sheets/SETUP.md ---
GOOGLE_SHEET_WEBHOOK_URL=  # the Apps Script web app's /exec URL
GOOGLE_SHEET_SECRET=       # same value as the script property SECRET

# --- Admin portal at /admin. The Google Sheet above is its database. ---
ADMIN_PASSWORD=            # sign-in password, 10+ characters. Without it the portal stays locked.
ADMIN_SESSION_SECRET=      # optional extra signing secret (any long random string); changing it signs everyone out
