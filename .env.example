# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=
NEXT_PUBLIC_PODCAST_PLAYLIST_URL=

# --- Database (PostgreSQL). Leave empty in local dev to use embedded Postgres (PGlite) in .data/ ---
# On Vercel use the provider's POOLED connection string, and a SEPARATE database per environment (never share one
# between preview and production). Apply migrations with:  DB_MIGRATE_CONFIRM_HOST=<host> npm run db:migrate
DATABASE_URL=
DB_POOL_MAX=               # optional, default 3 connections per instance
DB_AUTO_MIGRATE=           # "true" only for throwaway databases; otherwise migrate explicitly
RATE_LIMIT_STORE=          # postgres | memory. Default: postgres when DATABASE_URL is set, else memory
STORAGE_DRIVER=            # postgres | local. Default: postgres when DATABASE_URL is set, else local disk

# --- Who can see and use the site ---
# Closed by default. See docs/VERCEL-PREVIEW-RELEASE-PLAN.md for every value and who must approve it.
SITE_GATE_PASSWORD=        # 16+ characters. Requires HTTP Basic auth on every page, in any environment
SITE_GATE=                 # "off" to opt out of the fail-closed default on Vercel preview (only if host protection is verified)
PUBLIC_LAUNCH_APPROVED=    # must be exactly "true" before a Vercel PRODUCTION deployment serves the public
REGISTRATION_MODE=         # closed (default) | preview-synthetic | open
REGISTRATION_APPROVAL_REF= # required for "open": a reference to the written approval (6+ characters)

# --- Admin (no default account exists; both are required to enable /admin) ---
ADMIN_PASSWORD=            # 12+ characters
SESSION_SECRET=            # 32+ random characters: openssl rand -hex 32

# --- Payments (Razorpay). Without ALL of these, ticket purchase is unavailable and only the waitlist works ---
# PAYMENTS_ENABLED must be exactly "true". Keep it unset until the provider is verified and the fee/refund terms are final.
PAYMENTS_ENABLED=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend). Without these, no email is sent and the UI says so ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Storage ---
UPLOAD_DIR=                # defaults to .data/uploads (local disk). Use object storage on serverless hosts.
